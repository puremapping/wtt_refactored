# Where to Travel — 环境变量示例
# 复制为 .env 并填入真实值：cp .env.example .env

# ── 北京市公共数据开放平台 ─────────────────────────────
# 注册地址：https://data.beijing.gov.cn/cms/web/bjdata/sso/ssoLogin.jsp
# key 在【用户中心 - 我的唯一码】获取
# ⚠️ 该 key 是滚动值，会随页面访问刷新并使旧值失效
# 注：数据已随仓库提供（.research/ 与 data/wtt.db），日常运行不需要此 key
BJ_OPEN_DATA_KEY=

# ── 高德地图 Web 服务 API ──────────────────────────────
# 申请：https://lbs.amap.com/ → 控制台 → 应用管理 → 创建应用（服务平台选「Web服务」）
# 配额（个人认证，日）：地理编码/路径规划 5000，POI 搜索 100
# 用途：景区坐标补全 + 路径规划（按需查询）
AMAP_KEY=

# ── 智谱 GLM（对话 / 动机挖掘 / 行程叙述）───────────────
# 申请：https://open.bigmodel.cn/
# 实测：glm-4-flash 可用且最省，glm-4.7 可用但贵约 16 倍
GLM_API_KEY=
GLM_MODEL=glm-4-flash
GLM_MODEL_FALLBACK=glm-4.7

# ── 阿里云百炼（Embedding）──────────────────────────────
# 申请：https://bailian.console.aliyun.com/
# ⚠️ 必须使用 Workspace 专属端点——公共端点 dashscope.aliyuncs.com 不被接受
# 端点形如：https://<WORKSPACE_ID>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 在控制台「API Key」页面可查到完整 API Host
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
EMBEDDING_MODEL=text-embedding-v3

# ── 认证 ────────────────────────────────────────────────
# 用于签名登录 cookie。生成方式：
#   python -c "import secrets; print(secrets.token_hex(32))"
# ⚠️ 泄露会导致登录态可被伪造；不设置则每次重启生成临时值（用户会掉登录）
SECRET_KEY=
