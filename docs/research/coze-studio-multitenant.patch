+// CreateTeamSpace 创建团队空间（二次开发新增，未走 IDL 生成）
+//
+// 用于多租户模型：一个文旅局 = 一个 space。
+// 创建者自动成为 owner。
+func CreateTeamSpace(ctx context.Context, c *app.RequestContext) {
+	var req playground.CreateSpaceRequest
+	if err := c.BindAndValidate(&req); err != nil {
+		invalidParamRequestResponse(c, err.Error())
+		return
+	}
+	if req.Name == "" {
+		invalidParamRequestResponse(c, "name is required")
+		return
+	}
+
+	resp, err := user.UserApplicationSVC.CreateTeamSpace(ctx, &req)
+	if err != nil {
+		internalServerErrorResponse(ctx, c, err)
+		return
+	}
+
+	c.JSON(consts.StatusOK, resp)
+}
