+// CreateTeamSpace 创建团队空间（二次开发新增）
+//
+// 复用已有的 SpaceRepo.CreateSpace / AddSpaceUser，与注册时建个人空间的逻辑一致，
+// 区别只在于：名字由调用方给，且创建者即 owner。
+func (u *userImpl) CreateTeamSpace(ctx context.Context, userID int64,
+	name, description string) (space *userEntity.Space, err error) {
+	if userID <= 0 {
+		return nil, fmt.Errorf("invalid user id")
+	}
+	if name == "" {
+		name = "Team Space"
+	}
+
+	sid, err := u.IDGen.GenID(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("gen space_id failed: %w", err)
+	}
+
+	now := time.Now().UnixMilli()
+	err = u.SpaceRepo.CreateSpace(ctx, &model.Space{
+		ID:          sid,
+		Name:        name,
+		Description: description,
+		IconURI:     uploadEntity.EnterpriseIconURI,   // team_default_icon.png
+		SpaceType:   2,                                // 2 = 团队空间
+		OwnerID:     userID,
+		CreatorID:   userID,
+		CreatedAt:   now,
+		UpdatedAt:   now,
+	})
+	if err != nil {
+		return nil, fmt.Errorf("create team space failed: %w", err)
+	}
+
+	// 创建者自动成为 owner（role_type = 1）
+	err = u.SpaceRepo.AddSpaceUser(ctx, &model.SpaceUser{
+		SpaceID:   sid,
+		UserID:    userID,
+		RoleType:  1,
+		CreatedAt: now,
+		UpdatedAt: now,
+	})
+	if err != nil {
+		return nil, fmt.Errorf("add space owner failed: %w", err)
+	}
+
+	return &userEntity.Space{
+		ID:          sid,
+		Name:        name,
+		Description: description,
+		OwnerID:     userID,
+		CreatorID:   userID,
+		CreatedAt:   now,
+		UpdatedAt:   now,
+	}, nil
+}
